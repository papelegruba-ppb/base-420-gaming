@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  html {
    scroll-behavior: smooth;
  }
  body {
    @apply bg-ink-900 text-white font-sans antialiased;
  }
}

@layer utilities {
  .text-gradient-leaf {
    @apply bg-gradient-to-r from-electric-400 via-leaf-400 to-leaf-300 bg-clip-text text-transparent;
  }
  .text-gradient-play {
    @apply bg-gradient-to-r from-electric-400 via-white to-leaf-300 bg-clip-text text-transparent;
  }
  .glow-leaf {
    box-shadow: 0 0 40px -8px rgba(34, 197, 94, 0.5);
  }
  .glow-leaf-strong {
    box-shadow: 0 0 60px -10px rgba(34, 197, 94, 0.65);
  }
  .glow-electric {
    box-shadow: 0 0 44px -10px rgba(21, 156, 255, 0.65);
  }
}
